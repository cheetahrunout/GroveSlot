{
  "name": "groveslot",
  "private": true,
  "version": "1.0.0",
  "description": "Lowrider: a Grove Street slot for Grove Casino.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @lowrider/server --filter @lowrider/web run dev",
    "typecheck": "pnpm -r run typecheck && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "pnpm -r run build",
    "start": "pnpm --filter @lowrider/server run start",
    "sim": "pnpm --filter @lowrider/shared run sim",
    "odds": "pnpm --filter @lowrider/server run odds"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11"
  }
}
