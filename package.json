{
  "name": "groveslot",
  "private": true,
  "version": "1.0.0",
  "description": "Grove Street themed slot machine played with free tokens. For fun only, no real money.",
  "type": "module",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:page": "vite",
    "dev:server": "tsx watch server/main.ts",
    "build": "tsc --noEmit && vite build --config vite.single.config.ts && npm run build:server",
    "build:server": "esbuild server/main.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist-server/server.mjs --log-level=warning",
    "start": "node dist-server/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx tools/simulate.ts",
    "odds": "tsx tools/odds-check.ts"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.0",
    "esbuild": "0.28.2"
  }
}
